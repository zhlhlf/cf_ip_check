# ============================================================
# cfip 配置模板
#
# 复制一份改名为 cf.env 再填自己的参数:
#     cp cf.env.example cf.env
#
# cf.env 已被 .gitignore 忽略, 不会提交到仓库。
# ============================================================

# ---- 节点连接信息 (必填) ----
# TLS SNI, 也就是 xray config 里的 tlsSettings.serverName
SNI=example.com

# HTTP Host 头, 对应 wsSettings.host。不填则跟 SNI 相同
HOST=example.com

# 端口
PORT=2096

# WebSocket 路径 (键名是 WS_PATH, 避免和 shell 的 PATH 撞车)
WS_PATH=/

# 协议: trojan / vless / vmess
PROTOCOL=trojan

# 密码 / UUID。协议层凭证, 只有测速阶段用得到;
# 留空则不测速 (但握手筛选仍可正常工作)
PASSWORD=

# xray 可执行文件的绝对路径。测速阶段会用它起临时实例
XRAY_BIN=/usr/local/bin/xray

# ---- 测速 (可选) ----
# SPEED_URL 留空 = 完全不测速, 只做 WS 握手可用性筛选
#
# 别用 speed.cloudflare.com —— 代理本身就走 Cloudflare,
# 测它等于绕回自家边缘, 实测直接 0 字节失败。
SPEED_URL=https://proof.ovh.net/files/10Mb.dat

# 参与测速的候选数 (从握手排名里取前几名)
SPEED_TOP=5

# 每个 IP 重复下载几次取中位数。单次测速受丢包影响噪声很大, 建议 >= 3
SPEED_REPEATS=3

# 单次下载超时 (秒)
SPEED_TIMEOUT=40

# ---- 上次筛选结果 ----
# 用 -apply 运行时, 这里会被自动改写
IP=
