# cfip 配置
# 探测深度按配置自动切换:
#   HOST 空             -> 纯 TCP
#   HOST 有, PASSWORD 空 -> TCP + TLS
#   HOST 有, PASSWORD 有 -> TCP + TLS + WS 101, 并可隧道测速

# 节点域名, 同时作为 TLS SNI 和 HTTP Host
HOST=example.com

# 端口
PORT=2096

# WebSocket 路径
WS_PATH=/

# 协议: trojan / vless / vmess
PROTOCOL=trojan

# 密码 / UUID, 也是模式开关
PASSWORD=

# xray 可执行文件路径, 测速用
XRAY_BIN=/usr/local/bin/xray

# 写回 clash 配置 (可选): 改写 proxies 段前 16 个节点的 IP 和 port
CLASH_YML=

# ---- 测速 (可选) ----
# 留空 = 不测速。别用 speed.cloudflare.com, 会绕回自家边缘导致 0 字节
SPEED_URL=https://proof.ovh.net/files/10Mb.dat

# 参与测速的候选数
SPEED_TOP=5

# 每个 IP 重复次数, 取中位数
SPEED_REPEATS=3

# 单次下载超时 (秒)
SPEED_TIMEOUT=40
