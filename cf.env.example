# ============================================================
# cfip 配置模板
#
# 本模板已编译进二进制: 首次运行找不到 cf.env 时会自动生成。
# 改完保存再重跑即可, 不需要手动复制。
#
# cf.env 已被 .gitignore 忽略, 不会提交到仓库。
#
# 两种模式, 由 PASSWORD 决定:
#   PASSWORD 留空  -> 纯 TCP 探测, 零配置可跑, 只能筛掉不可达的 IP
#   PASSWORD 填了  -> TLS+WS 握手探测 + xray 隧道真实吞吐测速
# ============================================================

# ---- 节点连接信息 ----
# 节点域名。同时用作 TLS SNI (tlsSettings.serverName) 和 HTTP Host 头
# (wsSettings.host) —— 这两者在 CF 的 WS 节点上必然是同一个值。
# 只有填了 PASSWORD (TLS+WS 模式) 才必填, 纯 TCP 模式用不到。
HOST=example.com

# 端口
PORT=2096

# WebSocket 路径 (键名是 WS_PATH, 避免和 shell 的 PATH 撞车)
WS_PATH=/

# 协议: trojan / vless / vmess
PROTOCOL=trojan

# 密码 / UUID。这是模式开关:
#   留空 = 纯 TCP 探测 (默认), 不做 TLS/WS 握手, 也不测速
#   填了 = TLS+WS 握手探测, 并可用 xray 隧道做真实吞吐测速
PASSWORD=

# xray 可执行文件的绝对路径。测速阶段会用它起临时实例
XRAY_BIN=/usr/local/bin/xray

# ---- 写回 clash 配置 (可选) ----
# 填了就按最终排名改写该文件 proxies 段里前 16 个节点的 server IP 和 port
# (都用本文件上面的 PORT), 其余内容 (name/password/sni/ws-opts/注释) 原样保留。
# 留空 = 只在终端打印结果, 不改任何文件。
# 例: CLASH_YML=/etc/clash/config.yml
CLASH_YML=

# ---- 测速 (可选) ----
# SPEED_URL 留空 = 完全不测速, 只做 WS 握手可用性筛选
#
# 别用 speed.cloudflare.com —— 代理本身就走 Cloudflare,
# 测它等于绕回自家边缘, 实测直接 0 字节失败。
SPEED_URL=https://proof.ovh.net/files/10Mb.dat

# 参与测速的候选数 (从握手排名里取前几名)
SPEED_TOP=5

# 每个 IP 重复下载几次取中位数。单次测速受丢包影响噪声很大, 建议 >= 3
SPEED_REPEATS=3

# 单次下载超时 (秒)
SPEED_TIMEOUT=40
